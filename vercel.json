{
  "framework": "create-react-app",
  "installCommand": "npm install --prefix examfront && npm install --prefix backend",
  "buildCommand": "npm run build --prefix examfront",
  "outputDirectory": "examfront/build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|static/).*)", "destination": "/index.html" }
  ]
}
